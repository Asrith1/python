class Student:
	def __init__(self,fname,lname,no):
		self.first_name=fname
		self.last_name=lname
		self.regdno=no
	def display(self):
		print("First Name: ",self.first_name)
		print("Last Name: ",self.last_name)
		print("Roll.no: ",self.regdno)
obj = Student("Asrith","Eluri","23PA1A0564")
obj.display()

